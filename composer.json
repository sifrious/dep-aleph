{
    "name": "sifrious/aleph",
    "description": "Ingestion and observation infrastructure for Laravel applications.",
    "keywords": [
        "laravel",
        "ingestion",
        "connectors",
        "synchronization",
        "provenance"
    ],
    "homepage": "https://github.com/sifrious/aleph",
    "license": "MIT",
    "authors": [
        {
            "name": "sifrious",
            "email": "mmebit@icloud.com"
        }
    ],
    "require": {
        "php": "^8.4.1",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "psr/http-message": "^1.1|^2.0",
        "sifrious/funes": "dev-main",
        "smalot/pdfparser": "^2.12"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Aleph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Aleph\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\Aleph\\AlephServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../Funes",
            "options": {
                "symlink": true
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
