{
    "name": "sifrious/aleph",
    "description": "Ingestion and observation infrastructure for Laravel applications.",
    "keywords": [
        "laravel",
        "ingestion",
        "connectors",
        "synchronization",
        "provenance"
    ],
    "homepage": "https://github.com/sifrious/aleph",
    "license": "proprietary",
    "authors": [
        {
            "name": "sifrious",
            "email": "mmebit@icloud.com"
        }
    ],
    "require": {
        "dragonmantank/cron-expression": "^3.6",
        "php": "^8.4.1",
        "guzzlehttp/guzzle": "^7.9|^8.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/http": "^13.0",
        "illuminate/support": "^13.0",
        "psr/http-message": "^1.1|^2.0",
        "sifrious/authorization-contract": "dev-main#fc79e39723637f52730a1394b57797f57ee2a49b",
        "sifrious/funes": "dev-main#c7b4127ae1e47d27be3c000d0503b8b2c9f1e5a3",
        "smalot/pdfparser": "^2.12",
        "symfony/uid": "^7.0|^8.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Sifrious\\Aleph\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Sifrious\\Aleph\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "lint": "pint",
        "analyse": "phpstan analyse --memory-limit=512M"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Sifrious\\Aleph\\AlephServiceProvider"
            ]
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/sifrious/dep-authorization-contract.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/sifrious/dep-event-contract.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/sifrious/dep-funes.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/sifrious/dep-reference-contract.git"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
